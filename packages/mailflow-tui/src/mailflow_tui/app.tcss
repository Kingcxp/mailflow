/* MailFlow TUI layout — readable at normal terminal sizes. */

Screen {
    background: $ctp-base;
    color: $ctp-text;
}

Input, TextArea {
    background: $ctp-mantle;
    color: $ctp-text;
}

Input:focus, TextArea:focus {
    background-tint: transparent;
}

Input > .input--placeholder,
Input > .input--suggestion,
TextArea > .text-area--placeholder {
    color: $ctp-subtext0;
}

TextArea > .text-area--cursor {
    background: $ctp-rosewater;
    color: $ctp-base;
}

SelectCurrent {
    background: $ctp-mantle;
    color: $ctp-text;
}

SelectOverlay, OptionList, ListView {
    background: $ctp-base;
    color: $ctp-text;
}

OptionList > .option-list--highlighted,
ListView > ListItem.--highlight {
    background: $block-cursor-background;
    color: $ctp-text;
    text-style: bold;
}

Tabs, Tab {
    background: $ctp-mantle;
    color: $ctp-subtext0;
}

Tab.-active {
    background: $ctp-base;
    color: $ctp-lavender;
    text-style: bold;
}

Markdown {
    color: $ctp-text;
}

Markdown .code_inline {
    color: $ctp-peach;
    background: $ctp-surface0;
}

/* Filled semantic buttons, with all colors supplied by the active scheme.
   Keep focus visible without changing the fill or stacking Textual's tints. */
Button {
    height: auto;
    min-width: 16;
    border: none;
    text-style: bold;
    content-align: center middle;
    background: $button-default-background;
    color: $button-default-foreground;
    background-tint: transparent;
    tint: transparent;
    text-opacity: 1;
}

Button:enabled:hover,
Button:enabled:focus {
    background: $button-default-hover-background;
    color: $button-default-hover-foreground;
}

Button:enabled.-active {
    background: $button-default-active-background;
    color: $button-default-active-foreground;
}

Button:disabled {
    background: $button-default-disabled-background;
    color: $button-default-disabled-foreground;
    text-style: none;
    text-opacity: 1;
}

Button.-primary {
    background: $button-primary-background;
    color: $button-primary-foreground;
}

Button.-primary:enabled:hover,
Button.-primary:enabled:focus {
    background: $button-primary-hover-background;
    color: $button-primary-hover-foreground;
}

Button.-primary:enabled.-active {
    background: $button-primary-active-background;
    color: $button-primary-active-foreground;
}

Button.-primary:disabled {
    background: $button-primary-disabled-background;
    color: $button-primary-disabled-foreground;
}

Button.-success {
    background: $button-success-background;
    color: $button-success-foreground;
}

Button.-success:enabled:hover,
Button.-success:enabled:focus {
    background: $button-success-hover-background;
    color: $button-success-hover-foreground;
}

Button.-success:enabled.-active {
    background: $button-success-active-background;
    color: $button-success-active-foreground;
}

Button.-success:disabled {
    background: $button-success-disabled-background;
    color: $button-success-disabled-foreground;
}

Button.-warning {
    background: $button-warning-background;
    color: $button-warning-foreground;
}

Button.-warning:enabled:hover,
Button.-warning:enabled:focus {
    background: $button-warning-hover-background;
    color: $button-warning-hover-foreground;
}

Button.-warning:enabled.-active {
    background: $button-warning-active-background;
    color: $button-warning-active-foreground;
}

Button.-warning:disabled {
    background: $button-warning-disabled-background;
    color: $button-warning-disabled-foreground;
}

Button.-error {
    background: $button-error-background;
    color: $button-error-foreground;
}

Button.-error:enabled:hover,
Button.-error:enabled:focus {
    background: $button-error-hover-background;
    color: $button-error-hover-foreground;
}

Button.-error:enabled.-active {
    background: $button-error-active-background;
    color: $button-error-active-foreground;
}

Button.-error:disabled {
    background: $button-error-disabled-background;
    color: $button-error-disabled-foreground;
}

Button:focus {
    text-style: bold underline;
}

#mail-search-row {
    height: auto;
    align-vertical: middle;
}

#mail-search {
    width: 1fr;
}

#smart-action,
#actions-smart-action {
    height: 3;
    margin-left: 1;
}

#actions-search-row,
#market-search-row {
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#actions-search,
#market-search {
    width: 1fr;
}

#smart-search {
    height: 100%;
    margin: 0 1 0 1;
}

#mail-search-row Checkbox,
#actions-search-row Checkbox,
#market-search-row Checkbox,
#log-search-row Checkbox,
#settings-search-row Checkbox {
    width: auto;
    min-width: 9;
    margin-left: 1;
}

/* regex / case toggles: square blocks matching the input's 3-row height,
   wide enough that the 2-char label fits on ONE line without wrapping */
SearchToggle {
    width: 6;
    min-width: 6;
    height: 3;
    margin-left: 1;
    padding: 0;
    content-align: center middle;
}

#logs-search-status {
    height: auto;
    color: $text-muted;
}

SmartActionReviewModal,
SmartOperationEditModal {
    align: center middle;
}

#smart-review-dialog,
#smart-review-edit-dialog {
    width: 78;
    height: 90%;
    max-height: 90%;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}

#smart-review-title,
#smart-review-edit-title {
    text-style: bold;
    margin-bottom: 1;
}

#smart-review-edit-fields {
    height: 1fr;
    border: round $border-blurred;
    padding: 0 1;
}

#smart-action-body { height: 1fr; }
#smart-action-body Static { height: auto; }
#smart-action-request-title { color: $accent; }
#smart-action-request { border-left: solid $accent; padding-left: 1; }
#smart-action-request-title,
#smart-action-confirm-title { text-style: bold; }
#smart-action-confirm-title { color: $accent; margin-bottom: 1; }
#smart-action-confirm-hint { color: $text-muted; margin-bottom: 1; }
#smart-action-scope { color: $text-muted; margin-bottom: 1; }
#smart-action-animation { height: 1; margin-bottom: 1; }
#smart-action-animation LoadingIndicator { width: 8; height: 1; }
#smart-action-log { height: auto; color: $text-muted; padding-left: 1; }
#smart-action-result { border-top: solid $border-blurred; padding: 1 1 0 1; margin-top: 1; }
#smart-action-objects { margin-top: 1; }
#smart-review-operations { height: auto; margin-top: 1; }
#smart-review-buttons { align-horizontal: right; }

.smart-review-item {
    height: auto;
    border-left: solid $secondary;
    padding-left: 1;
    margin-bottom: 1;
}

.smart-review-item Checkbox {
    height: 1;
    border: none;
    padding: 0;
}

.smart-review-row {
    height: auto;
    align-vertical: middle;
}

.smart-review-row Static {
    width: 1fr;
}

#smart-review-notice,
#smart-review-error,
#smart-review-edit-error {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#smart-review-buttons,
#smart-review-edit-buttons {
    height: auto;
    margin-top: 1;
}

#smart-review-buttons Button,
#smart-review-edit-buttons Button {
    margin-right: 1;
}

Header {
    background: $panel;
    color: $foreground;
    text-style: bold;
}

HeaderTitle {
    color: $accent;
    text-style: bold;
}

Footer {
    background: $panel;
    color: $foreground;
}

#mail-table {
    width: 60%;
    height: 1fr;
    border: round $border-blurred;
}

#mail-detail {
    width: 40%;
    height: 1fr;
    border: round $border-blurred;
    padding: 0 1;
    overflow-y: auto;
}

ActionModal {
    layout: vertical;
    padding: 1 2;
}

#action-detail-scroll {
    width: 100%;
    height: 1fr;
    border: round $border-blurred;
    padding: 0 1;
    overflow-y: auto;
}

#action-footer {
    height: auto;
    margin-top: 1;
}

#action-footer Button {
    margin-right: 1;
}

#mail-controls {
    dock: bottom;
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#mail-actions-buttons {
    height: auto;
    width: 3fr;
}

#mail-actions-row1,
#mail-actions-row2,
#mail-actions-row3 {
    height: auto;
    align-vertical: middle;
}

/* The three selects take two thirds of the row (2fr each) and the button
   container one third; every button stretches to the same width inside its
   row and min-width 0 keeps the container from overflowing the screen. */
#mail-controls Select {
    width: 2fr;
    min-width: 0;
    margin-right: 1;
}

#mail-actions-row1 Button,
#mail-actions-row2 Button,
#mail-actions-row3 Button {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}

/* Todo create modal: centered bordered panel (reply/entry-dialog chrome) */
TodoCreateModal {
    align: center middle;
}
#todo-create-dialog {
    width: 64;
    height: auto;
    max-height: 90%;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}
#todo-create-title {
    text-style: bold;
    margin-bottom: 1;
}
#todo-create-form {
    height: auto;
    padding: 0 1;
}
.todo-label {
    color: $text-muted;
    margin-bottom: 0;
}
#todo-create-form Input,
#todo-create-form Select {
    margin-bottom: 1;
}
#todo-create-form ActionTypeField Select {
    margin-bottom: 0;
}
ActionTypeField > Button {
    height: 3;
}
#todo-create-error {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}
#todo-create-buttons {
    height: auto;
    margin-top: 1;
}
#todo-create-buttons Button {
    margin-right: 1;
}

#mail-detail > Static {
    height: auto;
    margin-bottom: 1;
}

#mail-body {
    color: $text;
}

#actions-body {
    height: 1fr;
}

#actions-table {
    width: 60%;
    height: 1fr;
    border: round $border-blurred;
}

#actions-detail {
    width: 40%;
    height: 1fr;
    border: round $border-blurred;
    padding: 0 1;
}

#actions-detail-scroll {
    height: 1fr;
}

#actions-source-mail {
    width: 100%;
    min-width: 0;
    margin-top: 1;
}

#action-mail-detail {
    margin-top: 1;
}

/* Horizontal defaults to height:1fr — without this the button row splits
   the remaining space 50/50 with the table */
#actions-buttons {
    height: auto;
    padding: 0 1;
}

#actions-type-filter {
    width: auto;
}

#actions-hint {
    height: 1;
    color: $text-muted;
}

#runtime-plugins, #runtime-adapters, #runtime-accounts,
#runtime-llms, #runtime-bindings, #runtime-storage {
    margin: 0 1;
}

#log-view {
    border: round $border-blurred;
    height: 1fr;
    margin: 0 1;
    padding: 0 1;
    background: $ctp-mantle;
}

/* Log export modal */
BotExportScreen {
    align: center middle;
}

/* Bot export wizard: centered bordered panel (same chrome as the other
   standalone dialogs — it had NO styles at all) */
#export-dialog {
    width: 76;
    height: auto;
    max-height: 90%;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}
#export-dialog .scaffold-title {
    text-style: bold;
    margin-bottom: 1;
}
#export-dialog #export-tree {
    height: 1fr;
    border: round $border-blurred;
    margin-bottom: 1;
}
#export-dialog #export-actions {
    height: auto;
    margin-top: 1;
}
#export-dialog #export-actions Button {
    margin-right: 1;
}

#log-export-dialog {
    width: 90%;
    max-width: 120;
    height: 90%;
    border: round $border-blurred;
    background: $surface;
    padding: 0 1;
}
#log-export-title {
    text-style: bold;
    margin-bottom: 1;
}
#log-export-tree {
    height: 1fr;
    margin-bottom: 1;
}
#log-export-filename {
    margin-bottom: 1;
}
#log-export-error {
    height: auto;
    margin-bottom: 1;
}
#log-export-actions Button {
    margin-right: 1;
}

#log-controls {
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#log-controls Select {
    width: 1fr;
    margin-right: 1;
}

#log-controls Input {
    width: 1fr;
}

#settings-label {
    margin: 1 1 0 1;
}

#language-select {
    width: 40%;
    margin: 1;
}

#settings-help {
    margin: 0 1;
    color: $text-muted;
}

#settings-config-title {
    margin: 1 1 0 1;
    text-style: bold;
}

#settings-config-scroll {
    height: 45%;
    margin: 0 1;
    border: round $border-blurred;
}

#config-table {
    height: auto;
}

#reply-title, #action-title {
    text-style: bold;
    margin: 1;
}

ReplyModal {
    align: center middle;
}

FeedbackModal {
    align: center middle;
}

LogExportScreen {
    align: center middle;
}

/* Ask & Correct modal: left chat, right mail info, bottom input row */
#ask-correct-title {
    text-style: bold;
    margin-bottom: 1;
    height: auto;
}
#ask-correct-body {
    height: 1fr;
    margin-bottom: 1;
}
#ask-correct-chat {
    width: 60%;
    height: 100%;
    border: round $border-blurred;
    padding: 0 1;
}
#ask-correct-chat-label,
#ask-correct-info-label {
    text-style: bold;
    color: $text-muted;
    margin-bottom: 1;
}
#ask-correct-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}
#ask-correct-messages {
    height: auto;
    padding: 0 1 1 1;
}
#ask-correct-messages .ask-correct-role {
    height: auto;
    margin-top: 1;
    margin-bottom: 0;
}
#ask-correct-messages Markdown {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}
#ask-correct-messages Markdown.ask-correct-user {
    background: $surface-lighten-1;
}
#ask-correct-messages Markdown.ask-correct-assistant {
    background: $surface;
}
#ask-correct-info {
    width: 40%;
    height: 100%;
    border: round $border-blurred;
    padding: 0 1;
}
#ask-correct-info > Static {
    margin-bottom: 1;
}
#ask-correct-input-row {
    height: 3;
    margin-bottom: 1;
}
#ask-correct-input {
    width: 1fr;
    height: 100%;
    margin-right: 1;
}
#ask-correct-send {
    margin-right: 1;
}
/* buttons match the input's bordered height instead of floating on its first
   line (they are `height: auto` from the base Button rule otherwise) */
#ask-correct-input-row Button {
    height: 100%;
}

#reply-dialog {
    width: 90;
    height: 80%;
    border: round $border-blurred;
    background: $surface;
    padding: 0 1;
}

#reply-templates {
    height: auto;
    margin: 0 1;
    align-vertical: middle;
}

#reply-templates Button {
    width: 12;
    margin-right: 1;
}

#reply-tpl-hint {
    color: $text-muted;
}

#reply-body {
    height: auto;
    min-height: 10;
    margin: 0 1;
    border: round $border-blurred;
}

#reply-toolbar {
    height: auto;
    margin: 0 1;
    align-vertical: middle;
}

#reply-toolbar .reply-tool {
    width: 4;
    margin-right: 1;
}

#reply-markup-hint {
    color: $text-muted;
    margin-left: 1;
}

#reply-actions {
    height: auto;
    margin: 1;
}

#reply-status {
    margin: 0 1;
    color: $text-muted;
}

#reply-confirm {
    margin-left: 1;
}

DataTable {
    background: $ctp-base;
    color: $ctp-text;
}

DataTable:focus {
    border: round $border-blurred;
}

DataTable > .datatable--header {
    background: $ctp-surface0;
    color: $ctp-text;
    text-style: bold;
}

DataTable > .datatable--cursor,
DataTable:focus > .datatable--cursor {
    background: $block-cursor-background;
    color: $ctp-text;
}

DataTable > .datatable--hover {
    background: $ctp-surface0;
}

#market-controls {
    height: auto;
    padding: 0 1;
}

#market-search-row,
#market-controls-top {
    height: auto;
    align-vertical: middle;
}

#market-category,
#market-sort {
    width: 1fr;
    margin-right: 1;
}

#market-refresh {
    height: 3;
    min-width: 8;
}

/* Keep the same list/detail balance as the mail and action pages. */
#market-body,
#runtime-body {
    height: 1fr;
    margin: 0 1;
}

#market-table,
#runtime-list {
    width: 3fr;
    height: 1fr;
}

#market-table,
#runtime-plugins-table {
    border: round $border-blurred;
}

#market-detail,
#runtime-detail {
    width: 2fr;
    height: 1fr;
    border: round $border-blurred;
    margin-left: 1;
    padding: 0 1;
}

#market-selection {
    height: auto;
    padding: 1 0;
}

#market-preview-scroll {
    height: 1fr;
}

#market-readme {
    height: auto;
    padding: 0;
}

#market-status,
#runtime-status {
    height: auto;
    max-height: 3;
    overflow-y: auto;
    margin: 0 1;
    color: $text-muted;
}

#market-actions,
#runtime-plugin-actions {
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#market-actions Button,
#runtime-plugin-actions Button {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}

#market-tools,
#runtime-plugin-uninstall {
    margin-right: 0;
}

#runtime-plugins-table {
    height: 1fr;
}

#runtime-plugins,
#runtime-plugins-hint {
    height: auto;
}

#runtime-plugins {
    color: $ctp-text;
    text-style: bold;
}

#runtime-plugins-hint {
    color: $text-muted;
}

#runtime-selection {
    height: auto;
    padding-top: 1;
    margin-bottom: 1;
}

#runtime-description,
#runtime-plugin-meta {
    height: auto;
    margin-bottom: 1;
}

#runtime-description {
    color: $ctp-subtext1;
}

#runtime-plugin-meta {
    color: $text-muted;
}

#runtime-scroll {
    height: 1fr;
}

#runtime-overview {
    padding: 0;
    margin: 0 0 1 0;
    border: none;
    background: $ctp-mantle;
}

#runtime-readme {
    height: auto;
    padding: 0;
}

#runtime-adapters,
#runtime-accounts,
#runtime-llms,
#runtime-bindings,
#runtime-storage {
    height: auto;
    margin: 0 0 1 0;
}

/* plugin scaffold wizard */
PluginScaffoldScreen {
    align: center middle;
}

#scaffold-dialog {
    width: 72;
    height: 32;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}

#scaffold-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#scaffold-dialog .scaffold-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#scaffold-tree {
    height: 14;
    border: round $border-blurred;
    margin-bottom: 1;
}

#scaffold-dialog Input,
#scaffold-dialog Select,
#scaffold-dialog Checkbox {
    margin-bottom: 1;
}

#scaffold-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

#scaffold-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* local plugin installer */
InstallScreen {
    align: center middle;
}

#install-dialog {
    width: 72;
    height: 32;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}

#install-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#install-dialog .scaffold-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#install-tree {
    height: 20;
    border: round $border-blurred;
    margin-bottom: 1;
}

#install-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

#install-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* remote repository manager */
ReposScreen {
    align: center middle;
}

#repos-dialog {
    width: 80;
    height: 24;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}

#repos-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#repos-table {
    height: 10;
    border: round $border-blurred;
    margin-bottom: 1;
}

#repos-form {
    height: auto;
}

#repos-form Input {
    margin-bottom: 1;
}

#repos-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

#repos-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* full-screen plugin detail */
MarketDetailScreen {
    align: center middle;
}

#market-detail-dialog {
    width: 96;
    max-width: 95%;
    height: 85%;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}

#market-detail-title {
    text-style: bold;
    color: $ctp-text;
    margin-bottom: 1;
}

#market-detail-scroll {
    height: 1fr;
    overflow-y: auto;
}

#market-detail-readme {
    height: auto;
    border: round $border-blurred;
    padding: 0 1;
}

#market-detail-status {
    height: 1;
    color: $text-muted;
}

#market-detail-actions {
    height: auto;
    align-vertical: middle;
}

#market-detail-actions Button {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}

#detail-close {
    margin-right: 0;
}

/* ---------------------------------------------------------------------------
   Settings editor (VS Code style): sidebar + searchable option cards
   --------------------------------------------------------------------------- */

#settings-body {
    height: 1fr;
}

#settings-sidebar {
    width: 28;
    border: round $border-blurred;
    margin: 0 1 0 1;
}

#settings-sidebar-title {
    text-style: bold;
    color: $ctp-text;
    padding: 0 1;
}

#settings-sections {
    height: 1fr;
    background: $ctp-mantle;
}

#settings-sections ListItem {
    padding: 0 1;  /* align section entries with the title above */
}

#settings-main {
    width: 1fr;
    margin-right: 1;
}

#settings-status {
    height: auto;
    color: $text-muted;
}

#settings-options {
    height: 1fr;
    border: round $border-blurred;
}

.settings-empty {
    padding: 1 2;
    color: $text-muted;
}

.option-card {
    height: auto;
    padding: 0 1 1 1;
    border-bottom: solid $panel;
}

.option-key {
    text-style: bold;
}

.option-desc {
    height: auto;
    color: $text-muted;
}

.option-default {
    height: auto;
    color: $text-disabled;
}

.option-row {
    height: 3;
    align-vertical: middle;
}

.option-input {
    width: 1fr;
    height: 3;
    margin-right: 1;
}

.option-summary {
    width: 1fr;
    height: 3;
    content-align: left middle;
    margin-right: 1;
    color: $text-muted;
}

.option-button {
    width: auto;
    min-width: 8;
    height: 3;
    padding: 0 1;
    margin-right: 1;
}

StateButton, .option-row StateButton {
    width: auto;
    min-width: 14;
    height: 3;
    padding: 0 2;
}

/* structured entry form + list editor windows */
ListEditScreen, EntryFormScreen {
    align: center middle;
}

#list-edit-dialog {
    width: 84;
    height: 26;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}

#list-edit-text {
    height: 1fr;
    border: round $border-blurred;
}

#entry-form-dialog {
    width: 88;
    height: 85%;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}

#entry-form-fields {
    height: 1fr;
    border: round $border-blurred;
    padding: 0 1;
}

#entry-form-status {
    height: auto;
    color: $error;
}

.dialog-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

.dialog-hint {
    height: auto;
    color: $text-muted;
}

.dialog-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

.dialog-actions Button {
    min-width: 16;
    margin: 0 1;
}

.field-label {
    text-style: bold;
    margin-top: 1;
}

.field-desc {
    height: auto;
    color: $text-muted;
}

.field-multiline {
    height: 5;
    border: round $border-blurred;
}

/* ---------------------------------------------------------------------------
   Mailbox and model configuration, plus historical mail dialog
   --------------------------------------------------------------------------- */

#connections-pane {
    height: 1fr;
}

#connections-pane > AccountsPane, #connections-pane > LLMPane {
    height: 1fr;
    min-height: 11;
}

#connections-pane > LLMPane {
    margin-top: 1;
}

#accounts-title, #llms-title, #history-title, #notifications-title {
    height: auto;
    text-style: bold;
    padding: 0 1;
    color: $ctp-text;
}

#accounts-help, #llms-help, #history-help, #notifications-help {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#accounts-table, #llms-table, #notifications-table {
    height: 1fr;
    min-height: 3;
    margin: 0 1;
    border: round $border-blurred;
}

#history-table {
    height: 1fr;
    min-height: 3;
    margin: 0 1;
    border: round $border-blurred;
}

#accounts-actions, #llms-actions, #history-actions, #notifications-actions {
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#accounts-actions Button, #llms-actions Button, #history-actions Button, #notifications-actions Button {
    margin-right: 1;
    min-width: 0;
    width: 1fr;
}

#accounts-status, #llms-status, #history-status, #notifications-status {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

MailHistoryScreen {
    align: center middle;
}

#history-dialog {
    width: 110;
    max-width: 95%;
    height: 85%;
    background: $surface;
    border: round $border-blurred;
    padding: 1;
}

#history-batch {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
}

#history-count-label {
    width: auto;
    height: 3;
    content-align: left middle;
    margin-right: 1;
    color: $text-muted;
}

#history-count {
    width: 10;
    height: 3;
}

#history-status {
    max-height: 3;
    overflow-y: auto;
}

#history-footer {
    height: auto;
    padding: 0 1;
    align-horizontal: right;
}

.secret-row {
    height: auto;
    align-vertical: middle;
}

.secret-row Input {
    width: 1fr;
}

.eye-btn {
    width: 6;
    min-width: 6;
    margin-left: 0;
}

/* reverse video on a tiny CJK label looks broken — use a subtle lighten */
.eye-btn:hover,
.eye-btn:focus {
    background: $surface-lighten-3;
    text-style: bold;
    color: $text;
}

#entry-form-extras {
    height: auto;
}


.secret-row Input {
    height: 3;
}

.secret-row .eye-btn {
    height: 3;
    content-align: center middle;
}


#notifications-status {
    max-height: 3;
    overflow-y: auto;
}

/* Gateway guide dialog: bordered frame, log pane, QR + status inside,
   buttons outside the frame */
#guide-title {
    content-align: center middle;
    text-style: bold;
    margin: 1 0;
}

#guide-dialog {
    width: 90;
    min-width: 80%;
    max-width: 95%;
    height: 95%;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}

#guide-title {
    content-align: center middle;
    height: 1;
}

#guide-log-wrap {
    /* the log pane takes all vertical space the other rows leave:
       it grows with the dialog height instead of leaving a gap */
    height: 1fr;
    min-height: 4;
    border: round $border-blurred;
    margin: 0 0 1 0;
    overflow-y: auto;
}

#guide-log {
    height: 100%;
    scrollbar-size: 1 1;
}

#guide-qr {
    /* height is pinned per-render by the guide (rows + 1) so the full
       QR always fits; no cap here — a cap clipped the last rows */
    height: auto;
    color: $text;
    margin-bottom: 1;
    content-align: center middle;
    text-align: center;
    padding: 1 1 0 1;
}

#guide-status {
    height: 1;
    color: $text;
    margin-bottom: 1;
}

#guide-actions {
    align: center middle;
    height: 3;
    margin: 0;
}

#guide-actions Button {
    height: 3;
    min-width: 12;
}

/* Bulk-action confirmation and the recipient profile form: the same centered
   bordered chrome as every other standalone dialog. */
ConfirmModal,
UserProfileModal {
    align: center middle;
}
#confirm-dialog {
    width: 76;
    height: auto;
    max-height: 80%;
    border: round $warning;
    background: $surface;
    padding: 1 2;
}
#confirm-title {
    text-style: bold;
    margin-bottom: 1;
    height: auto;
}
#confirm-body {
    height: auto;
    margin-bottom: 1;
}
/* the body scrolls: a dozen staged changes must not grow the box until the
   buttons are off-screen on a short terminal */
#confirm-body-scroll {
    height: auto;
    max-height: 60%;
    scrollbar-size-vertical: 1;
}
#confirm-buttons {
    height: auto;
    align-vertical: middle;
}
#confirm-buttons Button {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}
#profile-dialog {
    width: 90;
    height: auto;
    max-height: 90%;
    border: round $border-blurred;
    background: $surface;
    padding: 1 2;
}
#profile-title {
    text-style: bold;
    margin-bottom: 1;
}
#profile-hint {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}
#profile-scroll {
    height: 12;
    border: round $border-blurred;
    margin-bottom: 1;
}
#profile-text {
    height: 100%;
}
#profile-status {
    height: auto;
    margin-bottom: 1;
}
#profile-buttons {
    height: auto;
    align-vertical: middle;
}
#profile-buttons Button {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}

/* Keep search controls usable in narrow terminals by separating query rows
   from category/level selectors and letting the query input absorb space. */
#settings-search-row {
    dock: top;
    height: auto;
    margin: 0 1 1 1;
    align-vertical: middle;
}

#settings-search {
    width: 1fr;
}

#log-controls,
#log-filters,
#log-search-row {
    height: auto;
    align-vertical: middle;
}

#log-filters {
    padding: 0;
}

#log-search-row {
    padding: 0;
}

#log-search {
    width: 1fr;
}

#logs-export {
    min-width: 10;
    height: 3;
}

#actions-search-row,
#market-search-row {
    height: auto;
    align-vertical: middle;
}

#actions-search-row {
    padding: 0 1;
}

#market-search-row {
    padding: 0;
}

#smart-review-dialog,
#smart-review-edit-dialog {
    width: 96%;
    max-width: 78;
}

/* Existing dialogs: keep their fields and cancel controls within the viewport. */
#reply-form { height: 1fr; }
#reply-form Label, #reply-title { height: auto; }
#reply-status { height: auto; max-height: 4; overflow-y: auto; }
#todo-create-dialog { height: 85%; }
#todo-create-form { height: 1fr; }
#todo-weekdays { height: 9; }
#profile-text, #profile-guidelines { height: 8; }
#guide-view-qr { height: 1; min-height: 1; }
AssistedInput > Button { height: 3; }
#export-dialog, #install-dialog, #repos-dialog, #scaffold-dialog,
#entry-form-dialog, #list-edit-dialog {
    max-width: 95%;
    max-height: 90%;
}
#export-fields, #scaffold-fields { height: 1fr; }
#install-tree, #repos-table { height: 1fr; min-height: 3; }
#repos-actions Button { width: 1fr; min-width: 0; }
ListEditor .list-editor-row Button { min-width: 8; height: 1; }
