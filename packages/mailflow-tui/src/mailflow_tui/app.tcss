/* MailFlow TUI layout — readable at normal terminal sizes. */

Screen {
    background: #1e1e2e;
}

#mail-search {
    dock: top;
    margin: 0 1 1 1;
}

#mail-table {
    width: 60%;
    height: 60%;
    border: round $primary;
}

#mail-detail {
    width: 40%;
    height: 60%;
    border: round $secondary;
    padding: 0 1;
}

#mail-controls {
    dock: bottom;
    height: 3;
    padding: 0 1;
    align-vertical: middle;
}

#mail-controls Button,
#market-actions Button,
#runtime-plugin-actions Button {
    height: 3;
    content-align: center middle;
}

#mail-summary {
    color: $text;
}

#mail-body {
    margin-top: 1;
    height: auto;
    color: $text-muted;
}

#mail-notes {
    margin-top: 1;
}

#actions-table {
    width: 100%;
    height: 70%;
    border: round $primary;
}

#actions-hint {
    height: 1;
    color: $text-muted;
}

#runtime-plugins, #runtime-adapters, #runtime-accounts,
#runtime-llms, #runtime-bindings, #runtime-storage {
    margin: 0 1;
}

#log-view {
    border: round $accent;
    height: 100%;
}

#settings-label {
    margin: 1 1 0 1;
}

#language-select {
    width: 40%;
    margin: 1;
}

#settings-help {
    margin: 0 1;
    color: $text-muted;
}

#settings-config-title {
    margin: 1 1 0 1;
    text-style: bold;
}

#settings-config-scroll {
    height: 45%;
    margin: 0 1;
    border: round $primary;
}

#config-table {
    height: auto;
}

#reply-title, #action-title {
    text-style: bold;
    margin: 1;
}

ReplyModal {
    align: center middle;
}

#reply-dialog {
    width: 90;
    height: 80%;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

#reply-templates {
    height: 3;
    margin: 0 1;
    align-vertical: middle;
}

#reply-templates Button {
    width: 12;
    margin-right: 1;
    content-align: center middle;
}

#reply-tpl-hint {
    color: $text-muted;
}

#reply-body {
    height: auto;
    min-height: 10;
    margin: 0 1;
    border: round $primary;
}

#reply-toolbar {
    height: 3;
    margin: 0 1;
    align-vertical: middle;
}

#reply-toolbar .reply-tool {
    width: 4;
    height: 3;
    margin-right: 1;
    content-align: center middle;
}

#reply-markup-hint {
    color: $text-muted;
    margin-left: 1;
}

#reply-actions {
    height: 3;
    margin: 1;
}

#reply-status {
    margin: 0 1;
    color: $text-muted;
}

#reply-confirm {
    margin-left: 1;
}

DataTable {
    background: #181825;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $text;
}

#market-controls {
    height: 3;
    padding: 0 1;
}

#market-search {
    width: 50%;
}

#market-category {
    width: 24%;
}

#market-table {
    height: 45%;
    border: round $primary;
}

#market-detail {
    height: 45%;
    border: round $secondary;
    margin: 0 1;
}

#market-readme {
    height: 80%;
    padding: 0 1;
}

#market-status {
    height: 1;
    margin: 0 1;
    color: $text-muted;
}

#market-actions {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
}

#runtime-scroll {
    padding: 0 1;
}

#runtime-plugins-table {
    height: 8;
    border: round $primary;
    margin: 0 0 1 0;
}

#runtime-plugins-hint {
    height: 1;
    color: $text-muted;
}

#runtime-plugin-actions {
    height: 3;
    align-vertical: middle;
}

#runtime-status {
    height: 1;
    margin: 0 0 1 0;
    color: $text-muted;
}

/* plugin scaffold wizard */
PluginScaffoldScreen {
    align: center middle;
}

#scaffold-dialog {
    width: 72;
    height: 32;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#scaffold-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#scaffold-dialog .scaffold-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#scaffold-tree {
    height: 14;
    border: round $primary;
    margin-bottom: 1;
}

#scaffold-dialog Input,
#scaffold-dialog Select,
#scaffold-dialog Checkbox {
    margin-bottom: 1;
}

#scaffold-actions {
    height: 3;
    align-vertical: middle;
    content-align: center middle;
}

#scaffold-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* local plugin installer */
InstallScreen {
    align: center middle;
}

#install-dialog {
    width: 72;
    height: 32;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#install-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#install-dialog .scaffold-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#install-tree {
    height: 20;
    border: round $primary;
    margin-bottom: 1;
}

#install-actions {
    height: 3;
    align-vertical: middle;
    content-align: center middle;
}

#install-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}
