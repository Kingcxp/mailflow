/* MailFlow TUI layout — readable at normal terminal sizes. */

Screen {
    background: #1e1e2e;
}

/* Textual 8 buttons: the stock theme draws every variant on ansi_default
   (black-on-black on dark terminals) and its tall border makes fixed
   height:3 buttons overflow their 3-row containers. Use flat, explicit
   high-contrast variants with auto height (1 text row + line-pad). */
Button {
    height: auto;
    min-width: 16;
    border: none;
    text-style: bold;
    content-align: center middle;
}

Button.-default {
    background: $surface-lighten-1;
    color: $text;
}

Button.-primary {
    background: $primary;
    color: #11111b;
}

Button.-success {
    background: $success;
    color: #11111b;
}

Button.-warning {
    background: $warning;
    color: #11111b;
}

Button.-error {
    background: $error;
    color: #11111b;
}

Button:hover,
Button:focus {
    text-style: bold reverse;
}

#mail-search {
    dock: top;
    margin: 0 1 1 1;
}

#mail-table {
    width: 60%;
    height: 60%;
    border: round $primary;
}

#mail-detail {
    width: 40%;
    height: 60%;
    border: round $secondary;
    padding: 0 1;
}

#mail-controls {
    dock: bottom;
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#mail-summary {
    color: $text;
}

#mail-body {
    margin-top: 1;
    height: auto;
    color: $text-muted;
}

#mail-notes {
    margin-top: 1;
}

#actions-table {
    width: 100%;
    height: 70%;
    border: round $primary;
}

#actions-hint {
    height: 1;
    color: $text-muted;
}

#runtime-plugins, #runtime-adapters, #runtime-accounts,
#runtime-llms, #runtime-bindings, #runtime-storage {
    margin: 0 1;
}

#log-view {
    border: round $accent;
    height: 100%;
}

#settings-label {
    margin: 1 1 0 1;
}

#language-select {
    width: 40%;
    margin: 1;
}

#settings-help {
    margin: 0 1;
    color: $text-muted;
}

#settings-config-title {
    margin: 1 1 0 1;
    text-style: bold;
}

#settings-config-scroll {
    height: 45%;
    margin: 0 1;
    border: round $primary;
}

#config-table {
    height: auto;
}

#reply-title, #action-title {
    text-style: bold;
    margin: 1;
}

ReplyModal {
    align: center middle;
}

#reply-dialog {
    width: 90;
    height: 80%;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

#reply-templates {
    height: auto;
    margin: 0 1;
    align-vertical: middle;
}

#reply-templates Button {
    width: 12;
    margin-right: 1;
}

#reply-tpl-hint {
    color: $text-muted;
}

#reply-body {
    height: auto;
    min-height: 10;
    margin: 0 1;
    border: round $primary;
}

#reply-toolbar {
    height: auto;
    margin: 0 1;
    align-vertical: middle;
}

#reply-toolbar .reply-tool {
    width: 4;
    margin-right: 1;
}

#reply-markup-hint {
    color: $text-muted;
    margin-left: 1;
}

#reply-actions {
    height: auto;
    margin: 1;
}

#reply-status {
    margin: 0 1;
    color: $text-muted;
}

#reply-confirm {
    margin-left: 1;
}

DataTable {
    background: #181825;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $text;
}

#market-controls {
    padding: 0 1;
}

#market-search {
    width: 50%;
}

#market-category {
    width: 24%;
}

#market-table {
    height: 45%;
    border: round $primary;
}

#market-detail {
    height: 45%;
    border: round $secondary;
    margin: 0 1;
}

#market-readme {
    height: 80%;
    padding: 0 1;
}

#market-status {
    height: 1;
    margin: 0 1;
    color: $text-muted;
}

#market-actions {
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#runtime-scroll {
    padding: 0 1;
}

#runtime-plugins-table {
    height: 8;
    border: round $primary;
    margin: 0 0 1 0;
}

#runtime-plugins-hint {
    height: 1;
    color: $text-muted;
}

#runtime-plugin-actions {
    height: auto;
    align-vertical: middle;
}

#runtime-status {
    height: 1;
    margin: 0 0 1 0;
    color: $text-muted;
}

/* plugin scaffold wizard */
PluginScaffoldScreen {
    align: center middle;
}

#scaffold-dialog {
    width: 72;
    height: 32;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#scaffold-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#scaffold-dialog .scaffold-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#scaffold-tree {
    height: 14;
    border: round $primary;
    margin-bottom: 1;
}

#scaffold-dialog Input,
#scaffold-dialog Select,
#scaffold-dialog Checkbox {
    margin-bottom: 1;
}

#scaffold-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

#scaffold-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* local plugin installer */
InstallScreen {
    align: center middle;
}

#install-dialog {
    width: 72;
    height: 32;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#install-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#install-dialog .scaffold-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#install-tree {
    height: 20;
    border: round $primary;
    margin-bottom: 1;
}

#install-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

#install-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* market: two control rows so every button stays on screen */
#market-controls {
    height: auto;
    padding: 0 1;
}

#market-controls-top {
    height: auto;
    align-vertical: middle;
}

#market-controls-buttons {
    height: auto;
    align-vertical: middle;
}

#market-controls-buttons Button {
    margin-right: 1;
}

/* remote repository manager */
ReposScreen {
    align: center middle;
}

#repos-dialog {
    width: 80;
    height: 24;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#repos-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#repos-table {
    height: 10;
    border: round $primary;
    margin-bottom: 1;
}

#repos-form {
    height: auto;
}

#repos-form Input {
    margin-bottom: 1;
}

#repos-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

#repos-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* full-screen plugin detail */
MarketDetailScreen {
    align: center middle;
}

#market-detail-dialog {
    width: 96;
    height: 85%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#market-detail-title {
    text-style: bold;
    margin-bottom: 1;
}

#market-detail-readme {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#market-detail-status {
    height: 1;
    color: $text-muted;
}

#market-detail-actions {
    height: auto;
    align-vertical: middle;
}

#market-detail-actions Button {
    margin-right: 1;
}

/* config edit modal */
ConfigEditModal {
    align: center middle;
}

#config-edit-dialog {
    width: 76;
    height: 20;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#config-edit-title {
    text-style: bold;
    margin-bottom: 1;
}

#config-edit-key {
    margin-bottom: 1;
}

#config-edit-desc {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#config-edit-value-label {
    margin-bottom: 1;
}

#config-edit-input {
    margin-bottom: 1;
}

#config-edit-readonly {
    color: $text-muted;
    margin-bottom: 1;
}

#config-edit-status {
    height: 1;
    color: $error;
}

#config-edit-actions {
    height: auto;
    align-vertical: middle;
}

#config-edit-actions Button {
    width: 16;
    margin-right: 1;
}
