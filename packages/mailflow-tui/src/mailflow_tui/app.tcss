/* MailFlow TUI layout — readable at normal terminal sizes. */

Screen {
    background: #1e1e2e;
}

/* Textual 8 buttons: the stock theme draws every variant on ansi_default
   (black-on-black on dark terminals) and its tall border makes fixed
   height:3 buttons overflow their 3-row containers. Use flat, explicit
   high-contrast variants with auto height (1 text row + line-pad). */
Button {
    height: auto;
    min-width: 16;
    border: none;
    text-style: bold;
    content-align: center middle;
    /* Fallback for any variant Textual leaves on ansi_default (black on
       black in dark terminals): an explicit surface with readable text. */
    background: $surface-lighten-2;
    color: $text;
}

Button.-default {
    background: $surface-lighten-2;
    color: $text;
}

Button.-primary {
    background: $primary;
    color: #11111b;
}

Button.-success {
    background: $success;
    color: #11111b;
}

Button.-warning {
    background: $warning;
    color: #11111b;
}

Button.-error {
    background: $error;
    color: #11111b;
}

Button:disabled {
    background: $surface;
    color: $text-disabled;
}

Button:hover,
Button:focus {
    text-style: bold reverse;
}

#mail-search {
    dock: top;
    margin: 0 1 1 1;
}

#mail-table {
    width: 60%;
    height: 1fr;
    border: round $primary;
}

#mail-detail {
    width: 40%;
    height: 1fr;
    border: round $secondary;
    padding: 0 1;
    overflow-y: auto;
}

ActionModal {
    layout: vertical;
    padding: 1 2;
}

#action-detail-scroll {
    width: 100%;
    height: 1fr;
    border: round $secondary;
    padding: 0 1;
    overflow-y: auto;
}

#action-footer {
    height: auto;
    margin-top: 1;
}

#mail-controls {
    dock: bottom;
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#mail-actions-buttons {
    height: auto;
    width: 3fr;
}

#mail-actions-row1,
#mail-actions-row2 {
    height: auto;
    align-vertical: middle;
}

#mail-actions-spacer {
    height: 1;
}

/* the three selects share 2/3 of the row (2fr each), the button
   container takes 1/3; every button stretches to the same width and
   min-width 0 keeps the container from overflowing the screen */
#mail-controls Select {
    width: 2fr;
    margin-right: 1;
}

#mail-actions-row1 Button,
#mail-actions-row2 Button {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}

#mail-summary {
    color: $text;
}

#mail-body {
    margin-top: 1;
    height: auto;
    color: $text-muted;
}

#mail-notes {
    margin-top: 1;
}

#actions-controls {
    height: auto;
    padding: 0 1;
}

#actions-type-filter {
    width: 24;
}


#actions-table {
    width: 100%;
    height: 70%;
    border: round $primary;
}

#actions-hint {
    height: 1;
    color: $text-muted;
}

#runtime-plugins, #runtime-adapters, #runtime-accounts,
#runtime-llms, #runtime-bindings, #runtime-storage {
    margin: 0 1;
}

#log-view {
    border: round $accent;
    height: 100%;
}

#settings-label {
    margin: 1 1 0 1;
}

#language-select {
    width: 40%;
    margin: 1;
}

#settings-help {
    margin: 0 1;
    color: $text-muted;
}

#settings-config-title {
    margin: 1 1 0 1;
    text-style: bold;
}

#settings-config-scroll {
    height: 45%;
    margin: 0 1;
    border: round $primary;
}

#config-table {
    height: auto;
}

#reply-title, #action-title {
    text-style: bold;
    margin: 1;
}

ReplyModal {
    align: center middle;
}

FeedbackModal {
    align: center middle;
}

#feedback-dialog {
    width: 70;
    height: auto;
    max-height: 70%;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

#feedback-title {
    text-style: bold;
    margin-bottom: 1;
}

#feedback-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#feedback-reason {
    height: 6;
}

#feedback-buttons {
    height: auto;
    margin-top: 1;
}

#feedback-buttons Button {
    margin-right: 1;
}

#reply-dialog {
    width: 90;
    height: 80%;
    border: round $accent;
    background: $surface;
    padding: 0 1;
}

#reply-templates {
    height: auto;
    margin: 0 1;
    align-vertical: middle;
}

#reply-templates Button {
    width: 12;
    margin-right: 1;
}

#reply-tpl-hint {
    color: $text-muted;
}

#reply-body {
    height: auto;
    min-height: 10;
    margin: 0 1;
    border: round $primary;
}

#reply-toolbar {
    height: auto;
    margin: 0 1;
    align-vertical: middle;
}

#reply-toolbar .reply-tool {
    width: 4;
    margin-right: 1;
}

#reply-markup-hint {
    color: $text-muted;
    margin-left: 1;
}

#reply-actions {
    height: auto;
    margin: 1;
}

#reply-status {
    margin: 0 1;
    color: $text-muted;
}

#reply-confirm {
    margin-left: 1;
}

DataTable {
    background: #181825;
}

DataTable > .datatable--cursor {
    background: $accent;
    color: $text;
}

#market-controls {
    padding: 0 1;
}

#market-search {
    width: 50%;
}

#market-category {
    width: 24%;
}

#market-table {
    height: 45%;
    border: round $primary;
}

#market-detail {
    height: 45%;
    border: round $secondary;
    margin: 0 1;
}

#market-readme {
    height: 80%;
    padding: 0 1;
}

#market-status {
    height: 1;
    margin: 0 1;
    color: $text-muted;
}

#market-actions {
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#runtime-scroll {
    padding: 0 1;
}

#runtime-plugins-table {
    height: 8;
    border: round $primary;
    margin: 0 0 1 0;
}

#runtime-plugins-hint {
    height: 1;
    color: $text-muted;
}

#runtime-plugin-actions {
    height: auto;
    align-vertical: middle;
}

#runtime-status {
    height: 1;
    margin: 0 0 1 0;
    color: $text-muted;
}

/* plugin scaffold wizard */
PluginScaffoldScreen {
    align: center middle;
}

#scaffold-dialog {
    width: 72;
    height: 32;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#scaffold-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#scaffold-dialog .scaffold-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#scaffold-tree {
    height: 14;
    border: round $primary;
    margin-bottom: 1;
}

#scaffold-dialog Input,
#scaffold-dialog Select,
#scaffold-dialog Checkbox {
    margin-bottom: 1;
}

#scaffold-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

#scaffold-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* local plugin installer */
InstallScreen {
    align: center middle;
}

#install-dialog {
    width: 72;
    height: 32;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#install-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#install-dialog .scaffold-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#install-tree {
    height: 20;
    border: round $primary;
    margin-bottom: 1;
}

#install-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

#install-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* market: two control rows so every button stays on screen */
#market-controls {
    height: auto;
    padding: 0 1;
}

#market-controls-top {
    height: auto;
    align-vertical: middle;
}

#market-controls-buttons {
    height: auto;
    align-vertical: middle;
}

#market-controls-buttons Button {
    margin-right: 1;
}

/* remote repository manager */
ReposScreen {
    align: center middle;
}

#repos-dialog {
    width: 80;
    height: 24;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#repos-dialog .scaffold-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

#repos-table {
    height: 10;
    border: round $primary;
    margin-bottom: 1;
}

#repos-form {
    height: auto;
}

#repos-form Input {
    margin-bottom: 1;
}

#repos-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

#repos-actions Button {
    width: 16;
    margin: 0 1;
    content-align: center middle;
}

/* full-screen plugin detail */
MarketDetailScreen {
    align: center middle;
}

#market-detail-dialog {
    width: 96;
    height: 85%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#market-detail-title {
    text-style: bold;
    margin-bottom: 1;
}

#market-detail-readme {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#market-detail-status {
    height: 1;
    color: $text-muted;
}

#market-detail-actions {
    height: auto;
    align-vertical: middle;
}

#market-detail-actions Button {
    margin-right: 1;
}

/* ---------------------------------------------------------------------------
   Settings editor (VS Code style): sidebar + searchable option cards
   --------------------------------------------------------------------------- */

#settings-search {
    dock: top;
    margin: 0 1 1 1;
}

#settings-body {
    height: 1fr;
}

#settings-sidebar {
    width: 28;
    border: round $primary;
    margin: 0 1 0 1;
}

#settings-sidebar-title {
    text-style: bold;
    padding: 0 1;
}

#settings-sections {
    height: 1fr;
    background: #181825;
}

#settings-sections ListItem {
    padding: 0 1;  /* align section entries with the title above */
}

#settings-main {
    width: 1fr;
    margin-right: 1;
}

#settings-status {
    height: auto;
    color: $text-muted;
}

#settings-options {
    height: 1fr;
    border: round $secondary;
}

.settings-empty {
    padding: 1 2;
    color: $text-muted;
}

.option-card {
    height: auto;
    padding: 0 1 1 1;
    border-bottom: solid $panel;
}

.option-key {
    text-style: bold;
}

.option-desc {
    height: auto;
    color: $text-muted;
}

.option-default {
    height: auto;
    color: $text-disabled;
}

.option-row {
    height: auto;
    align-vertical: middle;
}

.option-input {
    width: 1fr;
    margin-right: 1;
}

.option-summary {
    width: 1fr;
    margin-right: 1;
    color: $text-muted;
}

.option-button {
    min-width: 14;
    margin-right: 1;
}

/* structured entry form + list editor windows */
ListEditScreen, EntryFormScreen {
    align: center middle;
}

#list-edit-dialog {
    width: 84;
    height: 26;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#list-edit-text {
    height: 1fr;
    border: round $primary;
}

#entry-form-dialog {
    width: 88;
    height: 85%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#entry-form-fields {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#entry-form-status {
    height: auto;
    color: $error;
}

.dialog-title {
    content-align: center middle;
    text-style: bold;
    margin-bottom: 1;
}

.dialog-hint {
    height: auto;
    color: $text-muted;
}

.dialog-actions {
    height: auto;
    align-vertical: middle;
    content-align: center middle;
}

.dialog-actions Button {
    min-width: 16;
    margin: 0 1;
}

.field-label {
    text-style: bold;
    margin-top: 1;
}

.field-desc {
    height: auto;
    color: $text-muted;
}

.field-multiline {
    height: 5;
    border: round $primary;
}

/* ---------------------------------------------------------------------------
   Mailboxes and LLM chain tabs
   --------------------------------------------------------------------------- */

#accounts-title, #llms-title, #history-title {
    text-style: bold;
    padding: 0 1;
}

#accounts-help, #llms-help, #history-help {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#accounts-table, #llms-table {
    height: 30%;
    margin: 0 1;
    border: round $primary;
}

#history-table {
    height: 1fr;
    margin: 0 1;
    border: round $secondary;
}

#accounts-actions, #llms-actions, #history-actions {
    height: auto;
    padding: 0 1;
    align-vertical: middle;
}

#accounts-actions Button, #llms-actions Button, #history-actions Button {
    margin-right: 1;
}

#accounts-status, #llms-status {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}


.secret-row {
    height: auto;
    align-vertical: middle;
}

.secret-row Input {
    width: 1fr;
}

.eye-btn {
    width: 6;
    min-width: 6;
    margin-left: 0;
}

/* reverse video on a tiny CJK label looks broken — use a subtle lighten */
.eye-btn:hover,
.eye-btn:focus {
    background: $surface-lighten-3;
    text-style: bold;
    color: $text;
}

#entry-form-extras {
    height: auto;
}


.secret-row Input {
    height: 3;
}

.secret-row .eye-btn {
    height: 3;
    content-align: center middle;
}


#notify-title {
    margin-bottom: 1;
    padding: 0 1;
    text-style: bold;
}

#notify-wrap {
    height: 45%;
}

#notify-feed {
    height: 1fr;
    border: round $secondary;
    background: #181825;
    padding: 0 1;
}

#bots-table-wrap {
    height: 1fr;
}

#bots-table {
    height: auto;
    max-height: 100%;
    border: round $primary;
}

#bots-login-help {
    margin-bottom: 1;
}

#bots-actions {
    height: auto;
    padding: 0 1;
}
